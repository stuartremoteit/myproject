# ── News ────────────────────────────────────────────────────────────────────────────────
# Get a free NewsAPI key at https://newsapi.org/register
# NEWSAPI_KEY=your_newsapi_key_here

# ── Watchlist ─────────────────────────────────────────────────────────────────────────────
# Override the default tickers (AAPL, TSLA, NVDA)
# TICKERS=AAPL,TSLA,NVDA,MSFT,GOOGL

# ── Price alerts ──────────────────────────────────────────────────────────────────────────
# TICKER>PRICE  fires when price rises AT OR ABOVE the threshold
# TICKER<PRICE  fires when price falls AT OR BELOW the threshold
# Multiple alerts are comma-separated. Alerts re-arm once price moves back.
# ALERTS=AAPL>200,TSLA<250,NVDA>900

# ── Market indices ───────────────────────────────────────────────────────────────────────
# Override the default index symbols (^GSPC, ^DJI, ^IXIC, ^RUT)
# MARKET_INDICES=^GSPC,^DJI,^IXIC,^RUT,^FTSE,BTC-USD

# ── Auto-refresh interval ─────────────────────────────────────────────────────────────────
# Default refresh interval for --watch mode (minutes)
# WATCH_INTERVAL=30
